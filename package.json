{
  "name": "villageplus-launcher",
  "version": "0.1.3",
  "private": true,
  "description": "VillagePlus desktop launcher",
  "main": "electron/bootstrap.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "pack:linux": "electron-builder --linux dir",
    "pack:win": "electron-builder --win portable"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "lucide": "0.468.0",
    "three": "0.180.0",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "dev.villageplus.launcher",
    "productName": "VillagePlus",
    "directories": {
      "output": "release"
    },
    "files": [
      "app/**/*",
      "electron/**/*",
      "core/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "bundle",
        "to": "bundle"
      }
    ],
    "linux": {
      "target": [
        "dir"
      ],
      "category": "Game",
      "icon": "app/assets/icon.png"
    },
    "win": {
      "target": [
        "portable"
      ],
      "icon": "app/assets/icon.png",
      "signAndEditExecutable": false
    }
  }
}
